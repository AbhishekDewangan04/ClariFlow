# ClariFlow Production Stack Environment Configuration
# Copy this file to .env before running: docker compose -f docker-compose.prod.yml up -d --build
# NEVER commit the actual .env file with real credentials to source control.

# Domain for Caddy automatic HTTPS (Let's Encrypt TLS)
DOMAIN=clariflow.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL Credentials
POSTGRES_DB=clariflow
POSTGRES_USER=clariflow
POSTGRES_PASSWORD=CHOOSE_A_STRONG_RANDOM_PASSWORD_HERE

# Telegram Bot Token (Rotated via @BotFather)
BOT_TOKEN=YOUR_ROTATED_BOT_TOKEN_HERE

# CORS origin (Optional: set to your domain if accessed across origins)
CORS_ORIGIN=https://clariflow.example.com
