# ClariFlow Backend Environment Variables

PORT=5000
DATABASE_URL=postgresql://clariflow:clariflow_password@localhost:5432/clariflow
BOT_TOKEN=your_telegram_bot_token_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required: a random string of at least 32 characters used to sign JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_32_chars_minimum

# ── Bootstrap Admin ───────────────────────────────────────────────────────────
# If no users exist in the database, these credentials create the first Admin
# account on server startup. Remove or leave blank after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_secure_password
ADMIN_NAME=Admin

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost dev origins.
# CORS_ORIGIN=https://clariflow.yourdomain.com,https://clariflow-frontend.vercel.app
