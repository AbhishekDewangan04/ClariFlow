# Leave empty in development: requests go through the Vite proxy (no CORS needed).
# For a deployed build, set the public URL of the API, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where the dev server proxies /api and /_health to.
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Display only: ISO 4217 code used to format totalAmount (the API doesn't report a currency).
VITE_CURRENCY=INR
