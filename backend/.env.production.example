# ClariFlow Backend Production Environment Template
# Duplicate this file to .env.production and provide real credentials. Never commit real values.

NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (Use SSL in cloud managed databases: ?sslmode=require)
DATABASE_URL=postgresql://clariflow:YOUR_SECURE_PASSWORD@postgres:5432/clariflow

# Telegram Bot Token (Rotated via @BotFather)
BOT_TOKEN=YOUR_ROTATED_TELEGRAM_BOT_TOKEN_HERE

# Optional: Restrict allowed CORS origins (leave unset if using unified reverse proxy)
CORS_ORIGIN=https://clariflow.yourdomain.com
